# SPDX-License-Identifier: AGPL-3.0-only
COMPOSE_PROJECT_NAME=cherrydash

# Development ports bind to loopback by default. Change deliberately for LAN access.
CHERRYDASH_BIND_HOST=127.0.0.1
CHERRYDASH_ADMIN_BIND_HOST=127.0.0.1
CHERRYDASH_ENVIRONMENT=development
CHERRYDASH_SERVER_PORT=8080
CHERRYDASH_INGEST_PORT=8081
CHERRYDASH_WEB_PORT=3000
CHERRYDASH_INGEST_SYNC_WRITES=false
CHERRYDASH_INGEST_KEYS_JSON=[{"tenant_id":"default","token":"development-only-change-me"}]
CHERRYDASH_INGEST_TOKEN=development-only-change-me
RUST_LOG=cherrydash=info,tower_http=info

POSTGRES_DB=cherrydash
POSTGRES_USER=cherrydash
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_PORT=5432

CLICKHOUSE_DB=cherrydash
CLICKHOUSE_USER=cherrydash
CLICKHOUSE_PASSWORD=change-me-before-production
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

CHERRYDASH_NATS_USER=cherrydash
CHERRYDASH_NATS_PASSWORD=change-me-before-production
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222
VALKEY_PORT=6379

MINIO_ROOT_USER=cherrydash
MINIO_ROOT_PASSWORD=change-me-before-production
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
