{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cherrydash.dev/domain-pack/v1/domain-pack.schema.json",
  "title": "CherryDash Domain Pack Manifest v1",
  "description": "Declarative industry/domain content. A domain pack does not receive native code execution rights.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "id", "name", "version", "domains", "content", "provenance"],
  "properties": {
    "apiVersion": { "const": "cherrydash.domain-pack/v1" },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:-]*$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "maxLength": 4096 },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:-]*$"
      }
    },
    "locales": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 64 },
      "default": ["en-US"]
    },
    "hostCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": { "type": "string", "maxLength": 64 },
        "maximumExclusive": { "type": "string", "maxLength": 64 }
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 160 },
      "default": []
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semanticModels": { "$ref": "#/$defs/pathList" },
        "unitDictionaries": { "$ref": "#/$defs/pathList" },
        "stateDictionaries": { "$ref": "#/$defs/pathList" },
        "dashboards": { "$ref": "#/$defs/pathList" },
        "monitorTemplates": { "$ref": "#/$defs/pathList" },
        "alertTemplates": { "$ref": "#/$defs/pathList" },
        "sloTemplates": { "$ref": "#/$defs/pathList" },
        "reports": { "$ref": "#/$defs/pathList" },
        "workflowProposals": { "$ref": "#/$defs/pathList" },
        "localizationBundles": { "$ref": "#/$defs/pathList" },
        "assets": { "$ref": "#/$defs/pathList" }
      }
    },
    "extensions": {
      "type": "array",
      "description": "References to separately reviewed adapters/renderers. The pack itself remains declarative.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "maxLength": 160 },
          "version": { "type": "string", "maxLength": 64 },
          "kind": { "enum": ["renderer", "data_source", "transform"] }
        }
      },
      "default": []
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string", "maxLength": 200 },
          "path": { "type": "string", "maxLength": 512 },
          "required": { "type": "boolean", "default": true }
        }
      },
      "default": []
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "source", "license"],
      "properties": {
        "owner": { "type": "string", "maxLength": 256 },
        "source": { "type": "string", "maxLength": 512 },
        "license": { "type": "string", "maxLength": 128 },
        "assetAttribution": { "type": "string", "maxLength": 4096 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewedBy": { "type": "string", "maxLength": 256 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": { "type": "string", "maxLength": 64 },
        "keyId": { "type": "string", "maxLength": 256 },
        "value": { "type": "string", "maxLength": 4096 }
      }
    }
  },
  "$defs": {
    "pathList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "uniqueItems": true,
      "default": []
    }
  }
}
