{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cherrydash.dev/dashboard/v1/renderer-manifest.schema.json",
  "title": "CherryDash Renderer Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "version",
    "displayName",
    "execution",
    "entrypoint",
    "supportedShapes"
  ],
  "properties": {
    "apiVersion": { "const": "cherrydash.renderer/v1" },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 2048
    },
    "execution": {
      "enum": ["built_in", "web_worker", "wasm", "sandboxed_iframe"]
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "integrity": {
      "type": "string",
      "maxLength": 256
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": { "type": "string", "maxLength": 64 },
        "keyId": { "type": "string", "maxLength": 256 },
        "value": { "type": "string", "maxLength": 4096 }
      }
    },
    "hostCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": { "type": "string", "maxLength": 64 },
        "maximumExclusive": { "type": "string", "maxLength": 64 }
      }
    },
    "supportedShapes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:-]*$"
      }
    },
    "minimumPanelSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 64 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "clipboard_write",
          "download",
          "camera",
          "microphone",
          "geolocation",
          "fullscreen",
          "external_navigation",
          "network_proxy"
        ]
      },
      "default": []
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "allowedOrigins": {
          "type": "array",
          "items": { "type": "string", "maxLength": 512 },
          "uniqueItems": true,
          "default": []
        }
      },
      "default": { "enabled": false, "allowedOrigins": [] }
    },
    "configurationSchema": {
      "type": "object",
      "additionalProperties": true
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keyboard": { "type": "boolean" },
        "screenReader": { "type": "boolean" },
        "tableFallback": { "type": "boolean" },
        "colorIndependent": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "license"],
      "properties": {
        "source": { "type": "string", "maxLength": 512 },
        "license": { "type": "string", "maxLength": 128 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewedBy": { "type": "string", "maxLength": 256 }
      }
    }
  }
}
