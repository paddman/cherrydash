{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cherrydash.dev/dashboard/v1/dashboard.schema.json",
  "title": "CherryDash Dashboard Definition v1",
  "description": "Industry-neutral, renderer-extensible dashboard contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "key", "title"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "key": { "$ref": "#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "description": { "type": "string", "maxLength": 4096 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "maxLength": 128 },
      "uniqueItems": true
    },
    "locale": { "type": "string", "default": "en-US", "maxLength": 128 },
    "timezone": { "type": "string", "default": "UTC", "maxLength": 128 },
    "domainProfiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true
    },
    "dataSources": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/dataSource" }
    },
    "variables": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/variable" }
    },
    "layouts": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/layout" }
    },
    "panels": {
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/panel" }
    },
    "settings": { "$ref": "#/$defs/settings" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:-]*$"
    },
    "configuration": {
      "oneOf": [
        { "type": "object", "additionalProperties": true },
        { "type": "null" }
      ],
      "default": null
    },
    "dataSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "adapter": { "$ref": "#/$defs/identifier" },
        "configuration": { "$ref": "#/$defs/configuration" },
        "secretRefs": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 3, "maxLength": 512 },
          "default": {}
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dataSourceRef", "queryType"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "dataSourceRef": { "$ref": "#/$defs/identifier" },
        "queryType": { "$ref": "#/$defs/identifier" },
        "expression": { "default": null },
        "expectedShape": { "$ref": "#/$defs/identifier" },
        "options": { "$ref": "#/$defs/configuration" }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "maxLength": 240 },
        "query": { "$ref": "#/$defs/query" },
        "defaultValue": { "default": null },
        "allowMultiple": { "type": "boolean", "default": false },
        "includeAll": { "type": "boolean", "default": false },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "maxLength": 240 },
              "value": {}
            }
          },
          "default": []
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "columns", "rowHeightPx"],
      "properties": {
        "key": { "$ref": "#/$defs/identifier" },
        "minWidthPx": { "type": "integer", "minimum": 0 },
        "columns": { "type": "integer", "minimum": 1, "maximum": 64 },
        "rowHeightPx": { "type": "integer", "minimum": 1, "maximum": 512 },
        "dense": { "type": "boolean", "default": false }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "x", "y", "width", "height"],
      "properties": {
        "layout": { "$ref": "#/$defs/identifier" },
        "x": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "y": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "width": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/identifier" },
        "configuration": { "$ref": "#/$defs/configuration" }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "action"],
      "properties": {
        "event": { "$ref": "#/$defs/identifier" },
        "action": { "$ref": "#/$defs/identifier" },
        "target": { "type": "string", "maxLength": 1024 },
        "configuration": { "$ref": "#/$defs/configuration" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "maxLength": 240 },
        "description": { "type": "string", "maxLength": 2048 },
        "tableFallback": { "type": "boolean", "default": false },
        "colorIndependent": { "type": "boolean", "default": false }
      },
      "default": {}
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "renderer"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "renderer": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "maxLength": 4096 },
        "queries": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/query" },
          "default": []
        },
        "placements": {
          "type": "array",
          "items": { "$ref": "#/$defs/placement" },
          "default": []
        },
        "transformations": {
          "type": "array",
          "items": { "$ref": "#/$defs/transform" },
          "default": []
        },
        "interactions": {
          "type": "array",
          "items": { "$ref": "#/$defs/interaction" },
          "default": []
        },
        "options": { "$ref": "#/$defs/configuration" },
        "accessibility": { "$ref": "#/$defs/accessibility" }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultTimeRange": { "type": "string", "maxLength": 128 },
        "refreshIntervalSeconds": { "type": "integer", "minimum": 1 },
        "liveMode": { "type": "boolean", "default": false },
        "displayModes": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true,
          "default": []
        },
        "maxQueryConcurrency": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "default": {}
    }
  }
}
